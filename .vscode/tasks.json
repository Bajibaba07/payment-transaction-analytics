{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Payment Analytics API",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"api.app:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Payment Analytics Dashboard",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"dashboard/app.py",
				"--server.address",
				"127.0.0.1",
				"--server.port",
				"8501"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}